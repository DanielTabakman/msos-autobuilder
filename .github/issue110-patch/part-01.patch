+        evidence["final_returncode"] = process.poll()
+    except Exception as exc:
+        evidence["error"] = _redact(str(exc))
+        try:
+            process.kill()
+            evidence["fallback_kill"] = True
+        except Exception as fallback_exc:
+            evidence["fallback_error"] = _redact(str(fallback_exc))
