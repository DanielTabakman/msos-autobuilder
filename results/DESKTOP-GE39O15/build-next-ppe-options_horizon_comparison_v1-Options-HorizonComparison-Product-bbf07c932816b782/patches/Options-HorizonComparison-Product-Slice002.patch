+"""Tests for deterministic option horizon comparison."""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime, timedelta
+
+from src.engine.options_horizon_comparison import (
+    ListedExpiryEvidence,
+    build_options_horizon_comparison,
+    select_nearest_listed_expiry,
+)
+from src.viz.options_horizon_comparison_boundary import (
+    build_options_horizon_comparison_response,
+)
+
+
+AS_OF = datetime(2026, 1, 1, tzinfo=UTC)
+
+
+def _expiry(days: int, **overrides: object) -> ListedExpiryEvidence:
+    expiry_dt = AS_OF + timedelta(days=days)
+    values = {
+        "expiry_ts": int(expiry_dt.timestamp() * 1000),
+        "expiry_date": expiry_dt.strftime("%Y-%m-%d"),
+        "forward_usd": 100_000.0 + days,
+        "atm_iv_annual": 0.5,
+        "quote_as_of_utc": AS_OF.isoformat(),
+        "open_interest": 100.0,
+        "liquidity_score": 0.8,
+    }
+    values.update(overrides)
+    return ListedExpiryEvidence(**values)  # type: ignore[arg-type]
+
+
+def test_nearest_expiry_tie_breaks_to_shorter_horizon() -> None:
+    selected = select_nearest_listed_expiry(
+        as_of_utc=AS_OF,
+        listed_expiries=[_expiry(35), _expiry(25)],
+        target_days=30,
+    )
+
+    assert selected is not None
+    assert selected.expiry_date == "2026-01-26"
+
+
+def test_comparison_deduplicates_when_buckets_share_expiry_and_orders_rows() -> None:
+    payload = build_options_horizon_comparison(
+        as_of_utc=AS_OF,
+        listed_expiries=[_expiry(31), _expiry(92), _expiry(185), _expiry(370)],
+    )
+
+    assert [row["target_bucket_days"] for row in payload["rows"]] == [30, 90, 180, 365]
+    assert [row["days_out"] for row in payload["rows"]] == [31, 92, 185, 370]
+    assert payload["meta"]["no_advice"] is True
+    assert "not a recommendation" in payload["limitations"][0]
+
+
+def test_missing_stale_and_thin_data_are_flagged_without_inference() -> None:
+    payload = build_options_horizon_comparison(
+        as_of_utc=AS_OF,
+        listed_expiries=[
+            _expiry(
+                30,
+                forward_usd=None,
+                atm_iv_annual=None,
+                quote_as_of_utc=(AS_OF - timedelta(hours=30)).isoformat(),
+                open_interest=1.0,
+            )
+        ],
+    )
+
+    row = payload["rows"][0]
+    assert row["forward_usd"] is None
+    assert row["atm_iv_annual"] is None
+    assert row["one_sigma_move_usd"] is None
+    assert row["data_flags"] == [
+        "missing_forward",
+        "missing_atm_iv",
+        "stale_quote",
+        "thin_liquidity",
+    ]
+
+
+def test_boundary_payload_shape_from_horizon_chart_like_payload() -> None:
+    expiry_dt = AS_OF + timedelta(days=60)
+    expiry_ts = int(expiry_dt.timestamp() * 1000)
+    payload = build_options_horizon_comparison_response(
+        {
+            "as_of_utc": AS_OF.isoformat(),
+            "forward": {
+                "curve": [
+                    {
+                        "expiry_utc": expiry_dt.isoformat(),
+                        "expiry_date": expiry_dt.strftime("%Y-%m-%d"),
+                        "mark_price_usd": 101_000.0,
+                    }
+                ]
+            },
+            "implied_by_expiry": {
+                str(expiry_ts): {
+                    "forward_usd": 101_000.0,
+                    "atm_iv_annual": 0.55,
+                    "quote_as_of_utc": AS_OF.isoformat(),
+                }
+            },
+        }
+    )
+
+    assert payload["kind"] == "options_horizon_comparison"
+    assert payload["rows"][0]["expiry_ts"] == expiry_ts
+    assert payload["rows"][0]["data_flags"] == []
+    assert payload["meta"]["http_path"] == "/ppe-display-api/horizon/comparison.json"
