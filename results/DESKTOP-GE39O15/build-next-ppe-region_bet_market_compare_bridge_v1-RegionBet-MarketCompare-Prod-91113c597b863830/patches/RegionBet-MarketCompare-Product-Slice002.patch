@@ -0,0 +1,34 @@
+"use client";
+
+import { OptionsHorizonComparisonPanel } from "@/components/OptionsHorizonComparisonPanel";
+import {
+  buildRegionBetMarketCompareInput,
+  buildRegionBetMarketComparePayload,
+} from "@/lib/regionBetMarketCompare";
+import type { RegionBetContract } from "@/lib/regionBet";
+
+type RegionBetMarketComparePanelProps = {
+  draft: RegionBetContract;
+};
+
+export function RegionBetMarketComparePanel({ draft }: RegionBetMarketComparePanelProps) {
+  const comparison = buildRegionBetMarketComparePayload(buildRegionBetMarketCompareInput(draft));
+  const region = comparison.region_context.selected_region;
+
+  return (
+    <div className="panel chart" data-testid="region-bet-market-compare-panel">
+      <div className="panel-head">
+        <div>
+          <h2>Compare listed windows</h2>
+          <div className="panel-sub">
+            Current draft: {comparison.region_context.symbol ?? comparison.region_context.asset_id},{" "}
+            {comparison.region_context.selected_expiry_utc.slice(0, 10)}, region{" "}
+            {region.price_min_usd} to {region.price_max_usd}.
+          </div>
+        </div>
+        <span className="tag">Compare</span>
+      </div>
+      <OptionsHorizonComparisonPanel comparison={comparison} />
+    </div>
+  );
+}
